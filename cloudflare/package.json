{
  "name": "jrxy_auto_cf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run check && node scripts/deploy.mjs",
    "check": "tsc --noEmit && node scripts/check-ui.mjs && node scripts/verify-build.mjs",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  },
  "dependencies": {
    "tldts": "7.5.4"
  }
}
